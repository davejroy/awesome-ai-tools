# Copy to .env.local and fill in real values — never commit .env.local

# Cloud Run backend URL (output of: terraform output cloud_run_url)
NEXT_PUBLIC_API_URL=https://vardryn-backend-dev-xyz.a.run.app

# Firebase project for App Hosting
NEXT_PUBLIC_FIREBASE_PROJECT_ID=vardryn-grc-prod

# WebAuthn relying-party ID (must match the domain serving the app)
NEXT_PUBLIC_RP_ID=localhost
NEXT_PUBLIC_RP_NAME=Vardryn GRC
